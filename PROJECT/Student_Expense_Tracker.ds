		menu
		{
			space Space
			{
				displayname = "Space"
				icon = "objects-spaceship"

				section Section_1
				{
					displayname = "Dashboard"
					icon = "ui-1-dashboard-half"
					page DashBoard
					{
						icon = "ui-1-dashboard-half"
					}
				}
				section Section_2
				{
					displayname = "Expense Records"
					icon = "health-notebook"
					form  expense_record
					{
						icon = "ui-1-bold-add"
					}
					report expense_record_Report
					{
						icon = "travel-world"
					}
					report expense_record_by_expense_category
					{
						icon = "business-currency-dollar"
					}
				}
				section Section_3
				{
					displayname = "Expense Category Masters"
					icon = "sport-trophy"
					form  expense_category_master
					{
						icon = "ui-1-bold-add"
					}
					report expense_category_master_Report
					{
						icon = "travel-world"
					}
				}
				section Section_4
				{
					displayname = "Monthly Budgets"
					icon = "business-progress"
					form  monthly_budget
					{
						icon = "ui-1-bold-add"
					}
					report monthly_budget_Report
					{
						icon = "shopping-tag-sale"
					}
				}
				section Section_5
				{
					displayname = "Student Profiles"
					icon = "education-pencil-47"
					form  student_profile
					{
						icon = "ui-1-bold-add"
					}
					report student_profile_Report
					{
						icon = "travel-world"
					}
					report student_profile_by_notification_preference
					{
						icon = "tech-2-p-heart"
					}
				}
				section Section_6
				{
					displayname = "Payment Method Masters"
					icon = "shopping-bitcoin"
					form  payment_method_master
					{
						icon = "ui-1-bold-add"
					}
					report payment_method_master_Report
					{
						icon = "shopping-bitcoin"
					}
				}
				section ZC_App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
					systemcomponent
					{
						type = connection
						displayname = "Integrations"
						icon = "tech-2-connection"
					}
				}
				section ZC_Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Tasks"
						icon = "ui-2-hourglass"
					}
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Tasks"
						icon = "design-todo"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
			}
			preference
			{
				icon
				{
					style = solid
					show = {space,section,component}
				}
			}
		}
		customize
		{
			new theme = 11
			font = "poppins"
			color options
			{
				color = "4"
			}
			logo
			{
				preference = "none"
				placement = "left"
			}
