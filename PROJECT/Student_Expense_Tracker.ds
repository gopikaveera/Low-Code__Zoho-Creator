		reports
		{
			report expense_record_Report
			{
				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								expense_id as "Expense Id"
								expense_date as "Expense Date"
								expense_name as "Expense Name"
								expense_amount as "Expense Amount"
								expense_category as "Expense Category"
								payment_method as "Payment Method"
								description as "Description"
								student as "Student"
								receipt_url as "Receipt URL"
								is_recurring as "Is Recurring"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
								Print 
								Add 
								Import 
								Export 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
							Print   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
		     				title = "Overview"
							fields
							(
