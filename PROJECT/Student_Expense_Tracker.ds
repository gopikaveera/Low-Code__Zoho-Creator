				width = medium
			)
			method_code
			(
    			type = text
				displayname = "Method Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			method_name
			(
    			type = text
				displayname = "Method Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			method_icon
			(
    			type = text
				displayname = "Method Icon"
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_default
			(
    			type = checkbox
				displayname = "Is Default"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			color_code
			(
    			type = text
				displayname = "Color Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			display_order
			(
				type = number
				displayname = "Display Order"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			student
			(
				type = list	
				displayname = "Student"
				values  = student_profile.ID
    			displayformat = [student_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form student_profile
		{
			displayname = "Student Profile"
			success message = "Student Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			student_name
			(
    			type = name
				displayname = "Student Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			student_email
			(
    			type = email
				displayname = "Student Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			student_phone
			(
    			type = phonenumber
				displayname = "Student Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			college_name
			(
    			type = text
				displayname = "College Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			student_id
			(
    			type = text
				displayname = "Student Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			account_status
			(
				type = picklist
				displayname = "Account Status"
				values = {"Active","Inactive","Suspended"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_currency
			(
				type = picklist
				displayname = "Preferred Currency"
				values = {"EUR","USD","INR"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			notification_preference
			(
				type = picklist
				displayname = "Notification Preference"
				values = {"Email","SMS","Both","Off"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = date
				displayname = "Created Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_login
			(
    			type = datetime
				displayname = "Last Login"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list expense_record_Report
		{
			displayName = "All Expense Records"
			show all rows from expense_record    
			(
				expense_id as "Expense Id"
				expense_date as "Expense Date"
				expense_name as "Expense Name"
				expense_amount as "Expense Amount"
				(
					display = total,average,min,max	
				)
				expense_category as "Expense Category"
				payment_method as "Payment Method"
				description as "Description"
				student as "Student"
				receipt_url as "Receipt URL"
				is_recurring as "Is Recurring"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (payment_method == "Card")
				fields = [payment_method]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (payment_method == "Cash")
				fields = [payment_method]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (payment_method == "NetBanking")
				fields = [payment_method]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (payment_method == "Wallet")
				fields = [payment_method]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban expense_record_by_expense_category
		{
			displayName = "Expense Categories"
			show all rows from expense_record    
			(
				expense_id as "Expense Id"
				expense_date as "Expense Date"
				expense_name as "Expense Name"
				expense_amount as "Expense Amount"
				(
					display = total,average,min,max	
				)
				expense_category as "Expense Category"
				payment_method as "Payment Method"
				description as "Description"
				student as "Student"
				receipt_url as "Receipt URL"
				is_recurring as "Is Recurring"
			)
			options
			(
	 			display field = expense_category
	 		)
		}
		list expense_category_master_Report
		{
			displayName = "All Expense Category Masters"
			show all rows from expense_category_master    
			(
				category_code as "Category Code"
				category_name as "Category Name"
				category_icon as "Category Icon"
				is_default as "Is Default"
				color_code as "Color Code"
				display_order as "Display Order"
				student as "Student"
				is_active as "Is Active"
			)
		}
		list monthly_budget_Report
		{
			displayName = "All Monthly Budgets"
			show all rows from monthly_budget    
			(
				budget_id as "Budget Id"
				budget_month as "Budget Month"
				budget_year as "Budget Year"
				budget_limit as "Budget Limit"
				(
					display = total,average,min,max	
				)
				budget_notes as "Budget Notes"
				student as "Student"
				is_active as "Is Active"
				last_updated as "Last Updated"
			)
		}
		list student_profile_Report
		{
			displayName = "All Student Profiles"
			show all rows from student_profile    
			(
				student_name  as "Student Name"
				student_email as "Student Email"
				student_phone as "Student Phone"
				college_name as "College Name"
				student_id as "Student Id"
				account_status as "Account Status"
				preferred_currency as "Preferred Currency"
				notification_preference as "Notification Preference"
				created_date as "Created Date"
				last_login as "Last Login"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (notification_preference == "Off")
				fields = [notification_preference]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (notification_preference == "SMS")
				fields = [notification_preference]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban student_profile_by_notification_preference
		{
			displayName = "Notification Preferences"
			show all rows from student_profile    
			(
				student_name  as "Student Name"
				student_email as "Student Email"
				student_phone as "Student Phone"
				college_name as "College Name"
				student_id as "Student Id"
				account_status as "Account Status"
				preferred_currency as "Preferred Currency"
				notification_preference as "Notification Preference"
				created_date as "Created Date"
				last_login as "Last Login"
			)
			options
			(
	 			display field = notification_preference
	 		)
		}
		list payment_method_master_Report
		{
			displayName = "All Payment Method Masters"
			show all rows from payment_method_master    
			(
				method_code as "Method Code"
				method_name as "Method Name"
				method_icon as "Method Icon"
				is_default as "Is Default"
				color_code as "Color Code"
				display_order as "Display Order"
				student as "Student"
				is_active as "Is Active"
			)
		}
	}
	pages
	{
		page DashBoard
		{
