 application "Student Expense Tracker"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form expense_category_master
		{
			displayname = "Expense Category Master"
			success message = "Expense Category Master Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			category_code
			(
    			type = text
				displayname = "Category Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			category_name
			(
    			type = text
				displayname = "Category Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			category_icon
			(
    			type = text
				displayname = "Category Icon"
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_default
			(
    			type = checkbox
				displayname = "Is Default"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			color_code
			(
    			type = text
				displayname = "Color Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			display_order
			(
				type = number
				displayname = "Display Order"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			student
			(
				type = list	
				displayname = "Student"
				values  = student_profile.ID
    			displayformat = [student_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form expense_record
		{
			displayname = "Expense Record"
			success message = "Expense Record Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			expense_id
			(
    			type = text
				displayname = "Expense Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			expense_date
			(
    			type = date
				displayname = "Expense Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			expense_name
			(
    			type = text
				displayname = "Expense Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			expense_amount
			(
				displayname = "Expense Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			expense_category
			(
				type = picklist
				displayname = "Expense Category"
				values = {"Utilities","Entertainment","Education","Health","Shopping","Transport","Food","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_method
			(
				type = picklist
				displayname = "Payment Method"
				values = {"NetBanking","Wallet","Cash","Card","UPI"}
				others option = true
	 			row = 1
	 			column = 2   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			student
			(
				type = list	
				displayname = "Student"
				values  = student_profile.ID
    			displayformat = [student_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
			receipt_url
			(
    			type = url
				displayname = "Receipt URL"
	 			row = 1
	 			column = 2   
				width = medium
			)
			is_recurring
			(
    			type = checkbox
				displayname = "Is Recurring"
				initial value = false
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form monthly_budget
		{
			displayname = "Monthly Budget"
			success message = "Monthly Budget Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			budget_id
			(
    			type = text
				displayname = "Budget Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			budget_month
			(
				type = picklist
				displayname = "Budget Month"
				values = {"June","October","December","May","September","March","July","January","February","April","August","November"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			budget_year
			(
				type = number
				displayname = "Budget Year"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			budget_limit
			(
				displayname = "Budget Limit"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			budget_notes
			(
    			type = textarea
				displayname = "Budget Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			student
			(
				type = list	
				displayname = "Student"
				values  = student_profile.ID
    			displayformat = [student_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_updated
			(
    			type = date
				displayname = "Last Updated"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form payment_method_master
		{
			displayname = "Payment Method Master"
			success message = "Payment Method Master Added Successfully"
			Section
			(
				type = section
	 			row = 1
