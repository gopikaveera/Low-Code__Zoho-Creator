		workflow
		{
		form
		{
			auto_set_student_email as "Auto-Set Student Email"
			{
				type =  form
				form = student_profile

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Get the logged-in user's email address
										loggedInEmail = zoho.loginuserid;
										// Check if the email is not null before assigning
										if(!loggedInEmail.isNull())
										{
											// Set the student_email field value
											input.student_email = loggedInEmail;
											// Disable the student_email field
											disable student_email;
										}
						)
					}
				}

			}
			validate_expense_amount as "Validate Expense Amount"
			{
				type =  form
				form = expense_record

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate expense amount before submission
										if(input.expense_amount <= 0)
										{
											alert "Error: Expense amount must be greater than zero. Please enter a valid amount.";
											cancel submit;
										}
						)
					}
				}

			}
		}






